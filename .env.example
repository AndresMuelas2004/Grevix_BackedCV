# Copy this file to .env and fill in your own keys. Never commit .env.

OPENAI_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=backedcv-dev

# Optional overrides
# BACKEDCV_ENV=dev
# BACKEDCV_MODEL_FAST=gpt-6-luna
# BACKEDCV_MODEL_STRONG=gpt-6.1-sol
# BACKEDCV_LLM_CACHE=true            # replay identical model calls from data/llm_cache.sqlite
# BACKEDCV_RATE_LIMIT_PER_HOUR=30    # model-using requests per client IP per hour
# BACKEDCV_DAILY_MODEL_RUNS=300      # model-using requests per day, all clients
