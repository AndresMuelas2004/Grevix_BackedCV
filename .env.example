# Copy this file to .env and fill in your own keys. Never commit .env.

ANTHROPIC_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
# Set to true once LANGSMITH_API_KEY is filled in.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=backedcv-dev

# Optional overrides
# BACKEDCV_ENV=dev
# BACKEDCV_MODEL_FAST=claude-haiku-5-5
# BACKEDCV_MODEL_STRONG=claude-haiku-5-5
# Replay identical model calls from data/llm_cache.sqlite (entries expire after 24 hours).
# BACKEDCV_LLM_CACHE=true
# Model-using requests per client IP per hour, and per day for all clients.
# BACKEDCV_RATE_LIMIT_PER_HOUR=30
# BACKEDCV_DAILY_MODEL_RUNS=300
